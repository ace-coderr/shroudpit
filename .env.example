# Optional. Extra devnet RPC endpoints, comma-separated, tried after the public endpoint when it
# rate-limits (HTTP 429) or fails. Leave empty to use only https://api.devnet.solana.com with
# exponential backoff. Never commit a URL that contains an API key; set it in your shell or in an
# untracked .env.local instead.
VITE_RPC_FALLBACK=
